{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safefun-cms",
  "compatibility_date": "2026-08-03",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.7,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "cms.safefun.it",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}